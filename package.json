{
  "name": "bottlecap",
  "version": "0.2.0",
  "private": true,
  "description": "开瓶器 · 汽水音乐下载器",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "pack": "node scripts/prepare-runtime.mjs && electron-vite build && electron-builder --dir",
    "dist": "node scripts/prepare-runtime.mjs && electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "author": "Bottlecap"
}
